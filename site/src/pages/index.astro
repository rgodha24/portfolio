---
import BaseLayout from "../layouts/BaseLayout.astro";
import { links } from "../data";
---

<BaseLayout title="homepage">
   <section class="hero">
      <header>
         <a class="brand" href="/">rohan godha</a>
         <nav>{links.slice(0, 3).map((l) => <a href={l.href}>{l.name}</a>)}</nav>
      </header>
      <canvas id="ascii" aria-hidden="true"></canvas>
      <div class="hero-inner">
         <h1>Rohan Godha</h1>
         <p class="sub">
            building <a href="https://tesser.sh">tesser</a> (yc w27). previously mintlify, rocketlab, cs @ georgia tech, and 70k ig followers <a href="https://instagram.com/aws_peter">@aws_peter</a>
         </p>
         <div class="cta">
            <a href="https://x.com/rohandevs">@rohandevs</a>
            <a href="/Resume.pdf">resume</a>
         </div>
      </div>
   </section>
</BaseLayout>

<script>
   import { startAscii } from "../ascii";

   let stop = () => {};
   document.addEventListener("astro:page-load", () => {
      stop();
      const canvas = document.getElementById("ascii") as HTMLCanvasElement | null;
      if (!canvas) return;
      stop = startAscii(canvas, {
         tick: 160,
         paint: "#1e1e1f",
         cursor: { radius: 110, paint: "#7fa6ff" },
      });
   });
</script>

<style>
   :global(:root) {
      --bg: #0c0c0d;
      --fg: #e4e4e2;
      --muted: #85857f;
      --faint: #55554f;
      --line: #1f1f1e;
      --sans: "Inter Variable";
      --mono: "IBM Plex Mono";
   }
   :global(body) { overflow: hidden; background: var(--bg); color: var(--fg); font-family: var(--sans), ui-sans-serif, system-ui, sans-serif; }
   a { text-decoration: none; color: inherit; }


   header {
      position: absolute; top: 0; left: 0; right: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center;
      padding: 20px max(24px, calc((100vw - 1040px) / 2));
   }
   .brand, nav, .hero-inner {
      background: rgb(12 12 13 / 0.55);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
   }
   .brand { font: 500 15px var(--mono), monospace; color: var(--fg); padding: 4px 10px; border-radius: 8px; }
   nav { display: flex; gap: 22px; font-size: 15px; color: var(--muted); padding: 4px 12px; border-radius: 8px; }
   nav a:hover { color: var(--fg); }

   .hero { position: relative; height: 100vh; height: 100dvh; display: grid; place-items: center; overflow: hidden; }
   #ascii { position: absolute; inset: 0; }
   .hero-inner {
      position: relative; text-align: center; padding: 20px 28px; max-width: min(760px, 100% - 32px); box-sizing: border-box; pointer-events: none; border-radius: 12px;
   }
   .hero-inner a { pointer-events: auto; }
   h1 { font-size: clamp(48px, 8vw, 96px); font-weight: 300; letter-spacing: -0.04em; line-height: 1; margin: 0; white-space: nowrap; }
   .sub { color: var(--muted); font-size: 18px; line-height: 1.6; margin: 20px auto 28px; max-width: 48ch; }
   .sub a { color: var(--fg); border-bottom: 1px solid var(--faint); }
   .sub a:hover { border-color: var(--fg); }
   .cta { display: flex; gap: 10px; justify-content: center; }
   .cta a { padding: 10px 0; width: 150px; border: 1px solid var(--line); color: var(--muted); font: 500 14px var(--mono), monospace; background: var(--bg); }
   .cta a:hover { color: var(--fg); border-color: var(--faint); }


   @media (max-width: 720px) { nav { display: none; } }
</style>
