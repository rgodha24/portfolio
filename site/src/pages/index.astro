---
// fonts are subset to what the page uses (fonttools pyftsubset) and inlined so first paint is right
import norwester from "../fonts/norwester.woff2?inline";
import raleway from "../fonts/raleway.woff2?inline";
import krypton from "../fonts/krypton.woff2?inline";

const faces = [["Norwester", norwester], ["Raleway", raleway], ["Monaspace Krypton", krypton]]
   .map(([family, src]) => `@font-face{font-family:"${family}";src:url(${src}) format("woff2");font-display:block}`)
   .join("");

const title = "Rohan Godha";
const description = "building tesser (yc w27). previously mintlify, rocketlab, cs @ georgia tech.";
const og = "https://og.rohangodha.com/api/og/bTI5cmhib2QybnF1MWo1OnN1bDZsNjg3bQ==?pageTitle=homepage";
---

<!doctype html>
<html lang="en">
   <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width,initial-scale=1" />
      <link rel="icon" href="/favicon.ico" />
      <link rel="canonical" href={Astro.site} />
      <title>{title}</title>
      <meta name="description" content={description} />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:image" content={og} />
      <meta name="twitter:card" content="summary_large_image" />
      <style is:inline set:html={faces} />
      {import.meta.env.PROD && <script is:inline data-collect-dnt="true" async defer src="https://api.rohangodha.com/latest.js" />}
   </head>
   <body>
      <section class="hero">
         <header>
            <a class="brand" href="/">rohan godha</a>
            <nav>
               <a href="https://x.com/rohandevs">twitter</a>
               <a href="https://github.com/rgodha24">github</a>
               <a href="https://www.linkedin.com/in/rohan-godha/">linkedin</a>
               <a href="/Resume.pdf">resume</a>
            </nav>
         </header>
         <canvas id="ascii" aria-hidden="true"></canvas>
         <div class="hero-inner">
            <h1>Rohan Godha</h1>
            <p class="sub">
               building <a href="https://tesser.sh">tesser</a> (yc w27). previously mintlify, rocketlab, cs @ georgia tech, and 70k ig followers <a href="https://instagram.com/aws_peter">@aws_peter</a>
            </p>
         </div>
         <canvas id="guy" aria-hidden="true"></canvas>
      </section>
      <script>
         import { startAscii } from "../ascii";

         startAscii(document.getElementById("ascii") as HTMLCanvasElement, {
            overlay: document.getElementById("guy") as HTMLCanvasElement,
            tick: 160,
            bg: "#0c0c0d",
            paint: "#1e1e1f",
            platforms: () => [...document.querySelectorAll("h1"), ...document.querySelectorAll(".brand, nav a")],
         });
      </script>
   </body>
</html>

<style>
   :global(:root) {
      --bg: #0c0c0d;
      --fg: #e4e4e2;
      --muted: #85857f;
      --faint: #55554f;
      --sans: "Raleway";
      --display: "Norwester";
      --mono: "Monaspace Krypton";
   }
   :global(body) { margin: 0; overflow: hidden; background: var(--bg); color: var(--fg); font-family: var(--sans), ui-sans-serif, system-ui, sans-serif; }
   a { text-decoration: none; color: inherit; }

   header {
      position: absolute; top: 0; left: 0; right: 0; z-index: 10; display: flex; justify-content: space-between; align-items: center;
      padding: 42px max(24px, calc((100vw - 1040px) / 2)) 20px;
   }
   .brand, nav, .hero-inner {
      background: rgb(12 12 13 / 0.55);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
   }
   .brand { font: 15px var(--mono), monospace; color: var(--fg); padding: 4px 10px; border-radius: 8px; }
   nav { display: flex; gap: 22px; font-size: 15px; color: var(--muted); padding: 4px 12px; border-radius: 8px; }
   nav a:hover { color: var(--fg); }

   .hero { position: relative; height: 100vh; height: 100dvh; display: grid; place-items: center; overflow: hidden; }
   #ascii, #guy { position: absolute; inset: 0; }
   #guy { z-index: 20; pointer-events: none; }
   .hero-inner {
      position: relative; text-align: center; padding: 20px 28px; max-width: min(760px, 100% - 32px); box-sizing: border-box; pointer-events: none; border-radius: 12px;
   }
   .hero-inner a { pointer-events: auto; }
   h1 { font: 400 clamp(56px, 9vw, 112px) var(--display), sans-serif; letter-spacing: 0.02em; line-height: 1; margin: 0; white-space: nowrap; }
   .sub { color: var(--muted); font-size: 18px; line-height: 1.6; margin: 20px auto 0; max-width: 48ch; }
   .sub a { color: var(--fg); border-bottom: 1px solid var(--faint); }
   .sub a:hover { border-color: var(--fg); }

   @media (max-width: 720px) { nav { display: none; } }
</style>
